    "03": {
      "id": "03",
      "slug": "03_第3章_函数极限与连续",
      "number": 3,
      "name": "第3章 函数极限与连续函数",
      "star": 3,
      "keypoints": [
        {"number": 1, "title": "函数极限 ε–δ / ε–X", "star": 3, "body": "有限点去心；无穷用 X；无穷大用 G；先限 $|x-x_0|<1$ 控系数再取 $\\delta=\\min\\{1,\\varepsilon/C\\}$。"},
        {"number": 2, "title": "单侧极限与 Heine 归结原则", "star": 3, "body": "左右极限换半邻域；Heine：极限存在 $\\iff$ 所有 $x_n\\to x_0$ 对应 $f(x_n)$ 同极限。"},
        {"number": 3, "title": "连续与间断点分类", "star": 3, "body": "连续不去心；间断点第一类（可去/跳跃）第二类（不存在/无穷）；$f$连续⇒$f^2,|f|$连续。"},
        {"number": 4, "title": "无穷小/无穷大量的阶", "star": 3, "body": "等价阶求 $a,\\alpha$；$\\ln^k x\\prec x^\\alpha\\prec a^x\\prec[x]!$；等价替换+Taylor。"},
        {"number": 5, "title": "闭区间连续函数（Cantor 等）", "star": 3, "body": "有界最值、介值零点、一致连续；$[a,+\\infty)$ 连续且极限有限⇒有界且一致连续。"}
      ],
      "examples": [
        {"title": "例3.1 按定义证 $x^3\\to8$", "body": "$|x^3-8|<19|x-2|$，取 $\\delta=\\min\\{1,\\varepsilon/19\\}$。"},
        {"title": "例3.3 单侧极限", "body": "$\\frac{2^{1/x}+1}{2^{1/x}-1}$：左 -1 右 1，不存在。"},
        {"title": "例3.5 零点存在", "body": "$x=a\\sin x+b$ 有正根，$f(0)<0,f(A)>0$。"},
        {"title": "例3.7 一致连续判定", "body": "$\\sin\\frac1x$ 在 $(0,1)$ 非一致连续（子列），在 $(a,1)$ 一致连续。"}
      ],
      "formulas": [
        {"name": "ε–δ 定义", "formula": "$$\\lim_{x\\to x_0}f=A\\iff\\forall\\varepsilon>0\\exists\\delta>0:0<|x-x_0|<\\delta\\Rightarrow|f-A|<\\varepsilon$$", "condition": "去心", "note": "", "importance": "must", "meaning": "函数极限", "derivation": "", "application": "极限证明", "related": "Heine"},
        {"name": "重要极限", "formula": "$$\\lim_{x\\to0}\\frac{\\sin x}{x}=1,\\quad\\lim_{x\\to\\infty}(1+\\frac1x)^x=e$$", "condition": "", "note": "", "importance": "must", "meaning": "两重要极限", "derivation": "面积比较/积分估计", "application": "求极限", "related": "等价无穷小"},
        {"name": "一致连续", "formula": "$$\\forall\\varepsilon>0\\exists\\delta>0\\forall x',x'':|x'-x''|<\\delta\\Rightarrow|f(x')-f(x'')|<\\varepsilon$$", "condition": "δ 不依赖点", "note": "", "importance": "must", "meaning": "整体一致", "derivation": "", "application": "Cantor 定理", "related": ""}
      ],
      "quizQuestions": [
        {"title": "自测1", "question": "ε–δ 证 $\\lim\\frac{x-1}{3x+1}=\\frac12$。", "answer": "$\\delta=\\min\\{1,6\\varepsilon\\}$。"},
        {"title": "自测3", "question": "证 Dirichlet 函数极限不存在。", "answer": "有理/无理子列极限不同。"},
        {"title": "自测5", "question": "证 $x^3+px+q=0$ 唯一实根。", "answer": "严格增+零点定理。"}
      ],
      "examMapping": "原书第3章 §1 题1-15、§2 题1-9、§3 题1-3、§4 题1-15。",
      "deps": ["03"],
      "depTypes": {"02": "tool"},
      "files": {"讲解.md": "03_第3章_函数极限与连续/讲解.md", "题库.md": "03_第3章_函数极限与连续/题库.md", "速查.md": "03_第3章_函数极限与连续/速查.md"}
    },
    "04": {
      "id": "04",
      "slug": "04_第4章_微分",
      "number": 4,
      "name": "第4章 微分",
      "star": 3,
      "keypoints": [
        {"number": 1, "title": "微分与导数定义", "star": 3, "body": "导数极限定义；可微 $\\Delta y=f'\\Delta x+o(\\Delta x)$；可导⇒连续；微元法近似。"},
        {"number": 2, "title": "导数的意义与性质", "star": 2, "body": "切线/法线斜率；左右导数相等⇔可导；$|f|$ 可导判别；$f(0)=0$ 时 $f=xg(x)$。"},
        {"number": 3, "title": "四则运算与反函数求导", "star": 3, "body": "乘积/商法则；反函数 $(f^{-1})'=1/f'$；基本求导表。"},
        {"number": 4, "title": "复合函数求导（链式）", "star": 3, "body": "链式；对数求导法（幂指）；隐函数；参数方程 $dy/dx=y_t'/x_t'$；一阶微分形式不变性。"},
        {"number": 5, "title": "高阶导数与高阶微分", "star": 2, "body": "逐阶；常用 $(e^{ax})^{(n)},(\\sin ax)^{(n)}$；Leibniz 公式。"}
      ],
      "examples": [
        {"title": "例4.1 微元法镀铜", "body": "$dV=4\\pi r^2dr$，$m=\\rho\\Delta V\\approx1.12$ g。"},
        {"title": "例4.3 双曲线面积", "body": "$xy=a^2$ 切线截三角形面积 $2a^2$ 定值。"},
        {"title": "例4.6 幂指函数", "body": "$y=x^x$，$y'=(1+\\ln x)x^x$。"},
        {"title": "例4.8 有理分式 n 阶导", "body": "$y=\\frac1{x^2-5x+6}$，拆部分分式得 $y^{(n)}$。"}
      ],
      "formulas": [
        {"name": "导数定义", "formula": "$$f'(x_0)=\\lim_{\\Delta x\\to0}\\frac{f(x_0+\\Delta x)-f(x_0)}{\\Delta x}$$", "condition": "", "note": "", "importance": "must", "meaning": "瞬时变化率", "derivation": "", "application": "一切求导", "related": "微分"},
        {"name": "链式法则", "formula": "$$\\frac{d}{dx}f(g(x))=f'(g(x))g'(x)$$", "condition": "", "note": "", "importance": "must", "meaning": "复合求导", "derivation": "", "application": "复合函数", "related": ""},
        {"name": "参数方程求导", "formula": "$$\\frac{dy}{dx}=\\frac{y'(t)}{x'(t)}$$", "condition": "$x'(t)\\ne0$", "note": "", "importance": "must", "meaning": "参数导数", "derivation": "$dy/dx=(dy/dt)/(dx/dt)$", "application": "参数曲线", "related": ""},
        {"name": "Leibniz 公式", "formula": "$$(uv)^{(n)}=\\sum_{k=0}^n C_n^k u^{(k)}v^{(n-k)}$$", "condition": "", "note": "", "importance": "familiar", "meaning": "乘积高阶导", "derivation": "归纳", "application": "求 $y^{(n)}(0)$", "related": ""}
      ],
      "quizQuestions": [
        {"title": "自测1", "question": "求 $\\lim\\frac{f(x_0+h)-f(x_0-h)}h$。", "answer": "$2f'(x_0)$。"},
        {"title": "自测3", "question": "求 $y=(\\sin x)^x$ 导数。", "answer": "$y'=(\\sin x)^x(\\ln\\sin x+x\\cot x)$。"},
        {"title": "自测6", "question": "求 $y=\\frac1{x+a}$ 的 $y^{(n)}$。", "answer": "$\\frac{(-1)^nn!}{(x+a)^{n+1}}$。"}
      ],
