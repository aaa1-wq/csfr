    "02": {
      "id": "02",
      "slug": "02_第2章_数列极限",
      "number": 2,
      "name": "第2章 数列极限",
      "star": 3,
      "keypoints": [
        {"number": 1, "title": "实数系的连续性：无理数与确界", "star": 3, "body": "无理数用反证+既约分数；$\\sup S=-\\inf\\{-x:x\\in S\\}$；$S=\\{x\\in\\mathbb Q:x^2<3\\}$ 在 $\\mathbb Q$ 内无上下确界。"},
        {"number": 2, "title": "ε–N 语言与无穷小", "star": 3, "body": "$x_n\\to a\\iff\\forall\\varepsilon>0\\exists N\\forall n>N:|x_n-a|<\\varepsilon$；证无穷小先放大到 $\\le\\frac Cn$ 再取 $N$。"},
        {"number": 3, "title": "夹逼定理", "star": 3, "body": "$a_n\\le c_n\\le b_n$，$a_n,b_n\\to L\\Rightarrow c_n\\to L$。"},
        {"number": 4, "title": "收敛准则、子列与基本列", "star": 3, "body": "子列判别、$\\sqrt{\\cdot}$保极限、无穷小×有界、单调有界、区间套、B–W、Cauchy 原理。"}
      ],
      "examples": [
        {"title": "例2.1 $\\mathbb Q$ 内确界不存在", "body": "$S=\\{x\\in\\mathbb Q:x^2<3\\}$ 无上确界：反设 $\\sup S=\\frac nm$，两种情况均矛盾。"},
        {"title": "例2.2 按定义证无穷小", "body": "$\\frac{n^2}{3^n}<\\frac1n$（$n>3$），取 $N=\\max\\{3,[1/\\varepsilon]\\}$。"},
        {"title": "例2.6 加权和", "body": "$\\sum\\lambda^{n-k}u_k\\to\\frac{a}{1-\\lambda}$（$|\\lambda|<1,u_k\\to a$）。"},
        {"title": "例2.8 单调有界", "body": "$x_1=\\sqrt2,x_{n+1}=\\sqrt{2+x_n}$，有界递增，$L=2$。"}
      ],
      "formulas": [
        {"name": "ε–N 定义", "formula": "$$x_n\\to a\\iff\\forall\\varepsilon>0\\exists N\\forall n>N:|x_n-a|<\\varepsilon$$", "condition": "", "note": "N 可依赖 ε 不依赖 n", "importance": "must", "meaning": "数列收敛", "derivation": "", "application": "一切数列极限", "related": "Cauchy"},
        {"name": "夹逼", "formula": "$$a_n\\le c_n\\le b_n,\\ a_n,b_n\\to L\\Rightarrow c_n\\to L$$", "condition": "大 n 成立", "note": "", "importance": "must", "meaning": "两边夹", "derivation": "同一 ε 控制", "application": "和式极限", "related": ""},
        {"name": "Cauchy 收敛原理", "formula": "$$\\forall\\varepsilon>0\\exists N\\forall m,n>N:|x_m-x_n|<\\varepsilon$$", "condition": "在 $\\mathbb R$ 中", "note": "完备性", "importance": "must", "meaning": "基本列收敛", "derivation": "有界+B–W", "application": "证收敛", "related": ""}
      ],
      "quizQuestions": [
        {"title": "自测1", "question": "证明 $\\sqrt6$ 无理。", "answer": "反证+既约分数矛盾。"},
        {"title": "自测4", "question": "奇偶子列同极限推全列。", "answer": "取 $N=\\max\\{2N_1,2N_2+1\\}$。"},
        {"title": "自测5", "question": "求 $\\sum\\frac1{n+\\sqrt k}$ 极限。", "answer": "夹逼得 1。"}
      ],
      "examMapping": "原书第2章 §1 题1-8、§2 题1-14、§3 题1-8、§4 题1-16。",
