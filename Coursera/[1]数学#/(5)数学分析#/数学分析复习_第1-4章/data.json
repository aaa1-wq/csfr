    "01": {
      "id": "01",
      "slug": "01_第1章_集合与映射",
      "number": 1,
      "name": "第1章 集合与映射",
      "star": 2,
      "keypoints": [
        {"number": 1, "title": "集合运算与命题辨析", "star": 2, "body": "子集计数 $2^n$；可列集（无限集含可列子集，可列∪可列可列）；分配律、De Morgan 律；消去律不成立需反例。"},
        {"number": 2, "title": "映射计数与区间一一对应", "star": 2, "body": "映射 $|T|^{|S|}$ 个，双射 $|S|!$ 个；$[a,b]\\to[0,1]$：$x\\mapsto\\frac{x-a}{b-a}$；$(0,1)\\to\\mathbb R$：$x\\mapsto-\\cot(\\pi x)$。"},
        {"number": 3, "title": "复合函数、定义域与值域", "star": 3, "body": "复合先算内层值域再与定义域取交；定义域三原则：分母非零、偶次根号内≥0、对数真数>0；函数相等需定义域和法则都同。"},
        {"number": 4, "title": "函数方程与奇偶分解", "star": 2, "body": "代换法：令 $t=\\varphi(x)$ 反解；任意函数 $f=\\frac{f(x)+f(-x)}2+\\frac{f(x)-f(-x)}2$；迭代 $f=\\frac1{1+x}$ 呈 Fibonacci 系数。"}
      ],
      "examples": [
        {"title": "例1.1 集合等式双向证明", "body": "$x\\in A\\cap(B\\cup D)\\Leftrightarrow x\\in A$ 且($x\\in B$或$x\\in D$)$\\Leftrightarrow x\\in(A\\cap B)\\cup(A\\cap D)$，双向包含。"},
        {"title": "例1.2 函数方程", "body": "$f(\\frac{x}{x-1})=\\frac{3x-1}{3x+1}$，令 $t=\\frac{x}{x-1}$，$x=\\frac{t}{t-1}$，得 $f(x)=\\frac{2x+1}{4x-1}$。"},
        {"title": "例1.3 定义域值域", "body": "$y=\\sqrt{4-3x-x^2}$：定义域 $[-4,1]$，值域 $[0,\\frac52]$。"},
        {"title": "例1.4 非单调双射", "body": "$f(x)=x$（有理）、$1-x$（无理），对合故双射，但不单调。"}
      ],
      "formulas": [
        {"name": "子集个数", "formula": "$$|\\mathcal P(T)|=2^n=\\sum_{k=0}^n C_n^k$$", "condition": "$|T|=n$", "note": "组合证明", "importance": "know", "meaning": "n元集子集数", "derivation": "按含k元素分类", "application": "集合计数", "related": ""},
        {"name": "区间双射", "formula": "$$[a,b]\\to[0,1]:x\\mapsto\\frac{x-a}{b-a}$$", "condition": "$a<b$", "note": "", "importance": "familiar", "meaning": "线性映到单位区间", "derivation": "端点对齐", "application": "等势", "related": ""},
        {"name": "奇偶分解", "formula": "$$f(x)=\\frac{f(x)+f(-x)}2+\\frac{f(x)-f(-x)}2$$", "condition": "定义域关于0对称", "note": "偶部+奇部", "importance": "must", "meaning": "任意函数拆偶奇", "derivation": "直接验证", "application": "函数性质", "related": ""}
      ],
      "quizQuestions": [
        {"title": "自测1", "question": "$n$元集有多少子集？", "answer": "$2^n$，$\\sum C_n^k=2^n$。"},
        {"title": "自测2", "question": "证明无限集含可列子集。", "answer": "逐个取新元素构造 $\\{a_1,a_2,\\dots\\}\\subset T$。"},
        {"title": "自测6", "question": "$f(\\frac{x}{x-1})=\\frac{3x-1}{3x+1}$ 求 $f(x)$。", "answer": "$f(x)=\\frac{2x+1}{4x-1}$。"}
      ],
      "examMapping": "原书第1章 §1 题1-7、§2 题1-13。",
